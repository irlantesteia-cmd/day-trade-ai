APP_ENV=development
LOG_LEVEL=INFO

# Banco de dados
# Dev local (default): SQLite
DATABASE_URL=sqlite:///./daytrade.db
# Dev com Postgres local ou docker-compose:
# DATABASE_URL=postgresql+psycopg2://daytrade:daytrade@localhost:5432/daytrade
# Dentro do docker-compose (rede interna):
# DATABASE_URL=postgresql+psycopg2://daytrade:daytrade@db:5432/daytrade

MARKET_SYMBOL=WIN
TIMEFRAME=1m

INITIAL_CAPITAL=10000.0
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=500.0
MAX_DRAWDOWN=0.10
MAX_EXPOSURE=1.0

TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# BROKER_API_KEY=sua_chave_aqui